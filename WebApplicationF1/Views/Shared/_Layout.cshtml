<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplicationF1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplicationF1.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" style="width: 64px;
    height: 64px;" href="~/css/Assets/F1_logo.png">

</head>
<body>
    <header>
        <nav class="">
            <ul class="navbar">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/css/Assets/F1_logo.png" class="imgF1">
                </a>

                <a asp-controller="Home" asp-action="Piloti">Piloti</a>
                <a asp-controller="Home" asp-action="Scuderie">Scuderie</a>
                <a asp-controller="Home" asp-action="Campionati">Campionati</a>
                <a asp-controller="Home" asp-action="" onclick="sponsors(event)">Sponsor</a>
                
                <select onchange="cambiaTema(this.value)" class="cambiaTema">
                    <option value="">Scegli tema</option>
                    <option value="chiaro">Chiaro</option>
                    <option value="scuro">Scuro</option>
                </select>

            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <a asp-controller="Home" asp-action="Sponsor" asp-route-name="aramco"><img src="~/css/Assets/aramco.png" alt="aramco" /></a>
        <a asp-controller="Home" asp-action="Sponsor" asp-route-name="aws"><img src="~/css/Assets/aws.png" alt="aws" /></a>
        <a asp-controller="Home" asp-action="Sponsor" asp-route-name="Crypto.com"><img src="~/css/Assets/Crypto.com.png" alt="Crypto.com" /></a>
        <a asp-controller="Home" asp-action="Sponsor" asp-route-name="dhl"><img src="~/css/Assets/dhl.png" alt="dhl" /></a>
        <a asp-controller="Home" asp-action="Sponsor" asp-route-name="heineken"><img src="~/css/Assets/heineken.png" alt="heineken" /></a>
        <a asp-controller="Home" asp-action="Sponsor" asp-route-name="petronas"><img src="~/css/Assets/petronas.png" alt="petronas" /></a>
        <a asp-controller="Home" asp-action="Sponsor" asp-route-name="qatarAirways"><img src="~/css/Assets/qatarAirways.png" alt="qatarAirways" /></a>
        <a asp-controller="Home" asp-action="Sponsor" asp-route-name="lenovo"><img src="~/css/Assets/lenovo.png" alt="lenovo" /></a>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
