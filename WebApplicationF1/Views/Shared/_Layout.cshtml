<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApplicationF1</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplicationF1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="">
            <ul class="navbar">
                <a asp-controller="Home" asp-action="Index">
                    <img src="~/css/Assets/F1_logo.png" class="imgF1">
                </a>

                <a asp-controller="Home" asp-action="Piloti">Piloti</a>
                <a asp-controller="Home" asp-action="Scuderie">Scuderie</a>
                <a asp-controller="Home" asp-action="Campionati">Campionati</a>

            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            &copy; 2026 - WebApplicationF1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
