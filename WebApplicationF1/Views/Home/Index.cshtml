@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>F1</title>
    <link rel="stylesheet" href="~/css/site.css">

</head>
<body>
    
    <div class="season">
        <p>ULTIME NOTIZIE</p>
    </div>

    <div class="box2">
            @foreach (var n in Model)
            {
                <a asp-action="Notizia" asp-controller="Home" asp-route-id="@n.IdNotizia" class="boxNotizia">
                    <img src="~/css/Assets/Notizie/@(n.IdNotizia).png" ) />
                    <p class="notizia-data">@n.DataDiPubblicazione</p>
                    <h3>@n.Titolo</h3>
                </a>
            }
    </div>

    <br /><br /><br /><br />

    <div class="season">
        <p>STAGIONE 2026</p>
    </div>
    <div class="box">
        <div class="boxDriver rosso">
            <div class="boxContent">
                <h3>2nd</h3>
                <p>Lewis Hamilton</p> <br>
                <p>Ferrari</p>
            </div>
            <img src="~/css/Assets/hamilton.png">
        </div>

        <div class="boxDriver azzurro">
            <div class="boxContent">
                <h3>1st</h3>
                <p>Kimi Antonelli</p> <br>
                <p>Mercedes</p>
            </div>
            <img src="~/css/Assets/antonelli.png">
        </div>

        <div class="boxDriver azzurro">
            <div class="boxContent">
                <h3>3rd</h3>
                <p>George Russel</p> <br>
                <p>Mercedes</p>
            </div>
            <img src="~/css/Assets/russell.png">
        </div>
            <table class="boxClassifica">
                <tr>
                    <td>POS.</td>
                    <td>PILOTA</td>
                    <td>NAZIONALITA'</td>
                    <td>TEAM</td>
                    <td>PT.</td>
                </tr>
                <tr>
                <tr>
                    <td>1</td>
                    <td>Kimi Antonelli</td>
                    <td>Italia</td>
                    <td>Mercedes</td>
                    <td>156</td>
                </tr>
                <tr>
                    <td>2</td>
                    <td>Lewis Hamilton</td>
                    <td>Regno Unito</td>
                    <td>Ferrari</td>
                    <td>115</td>
                </tr>
                <tr>
                    <td>3</td>
                    <td>George Russel</td>
                    <td>Regno Unito</td>
                    <td>Mercedes</td>
                    <td>106</td>
                </tr>
                <tr>
                    <td>4</td>
                    <td>Charles Leclerc</td>
                    <td>Monaco</td>
                    <td>Ferrari</td>
                    <td>75</td>
                </tr>
                <tr>
                    <td>5</td>
                    <td>Lando Norris</td>
                    <td>Regno Unito</td>
                    <td>McLaren</td>
                    <td>73</td>
                </tr>
                <tr>
                    <td>6</td>
                    <td>Oscar Piastri</td>
                    <td>Australia</td>
                    <td>McLaren</td>
                    <td>68</td>
                </tr>
                
                <tr>
                    <td>7</td>
                    <td>Max Verstappen</td>
                    <td>Paesi Bassi</td>
                    <td>Red Bull Racing</td>
                    <td>55</td>
                </tr>
                <tr>
                    <td>8</td>
                    <td>Pierre Gasly</td>
                    <td>Francia</td>
                    <td>Alpine</td>
                    <td>41</td>
                </tr>
                <tr>
                    <td>9</td>
                    <td>Isack Hadjar</td>
                    <td>Francia</td>
                    <td>Racing Bulls</td>
                    <td>34</td>
                </tr>
                <tr>
                    <td>10</td>
                    <td>Liam Lawson</td>
                    <td>Nuova Zelanda</td>
                    <td>Racing Bulls</td>
                    <td>28</td>
                </tr>
                
            </table>
        </div>
    </body>
</html>