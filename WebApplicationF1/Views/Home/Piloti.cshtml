@model IEnumerable<WebApplicationF1.Models.Pilota>
@{
    ViewData["Title"] = "Piloti";
}
<a class="torna" style="margin: 3%" href="javascript:history.back()">← Torna alla pagina precedente</a>

<div class="box db-piloti">

    @{
        var pilotList = (Model ?? Enumerable.Empty<WebApplicationF1.Models.Pilota>()).OrderBy(p => p.Cognome).ThenBy(p => p.Nome).ToList();
        
    }

    @if (pilotList.Any())
    {
        @for (int i = 0; i < pilotList.Count; i++)
        {
            var p = pilotList[i];
            <div class="boxDriver @(p.Colore)" id="pilot-@p.IdPilota">

                <div class="boxContent">
                    <a asp-action="StoricoPilota" asp-route-id="@p.IdPilota" style="text-decoration:none; color:inherit;">
                        <p>@p.Nome @p.Cognome</p>
                        <p>@p.Nazionalita</p>
                        <p>@p.DataDiNascita.ToString()</p>
                    </a>
                    <br />
                    
                </div>

                <img src="~/css/Assets/@(p.Cognome).png" alt="@p.Nome" type="button" onclick="caricaPilotaInForm('@p.IdPilota', '@p.Nome', '@p.Cognome', '@p.DataDiNascita', '@p.Nazionalita', '@p.Colore')" />

            
          
			</div>

        }
    }
    else
    {
        <p>Nessun pilota nel database.</p>
    }
    <br />

    <details class="addPilota">
        <summary>Aggiungi pilota</summary>
        <form asp-action="AddPilota" method="post" class="add-pilota-form">
            <div><label>Nome: <input name="Nome" required /></label></div>
            <div><label>Cognome: <input name="Cognome" required /></label></div>
            <div><label>Data di nascita: <input type="date" name="DataDiNascita" required /></label></div>
            <div><label>Nazionalità: <input name="Nazionalita" /></label></div>
            <div><label>Colore: <input name="Colore" /></label></div>
            <div><button type="submit">Aggiungi Pilota</button></div>
        </form>
    </details>

    <details class="addPilota">
        <summary>Modifica Pilota Selezionato</summary>
        <form asp-action="UpdatePilota" method="post">
            <input type="hidden" name="IdPilota" id="edit-id" />

            <div><label>Nome: <input name="Nome" id="edit-nome" required /></label></div>
            <div><label>Cognome: <input name="Cognome" id="edit-cognome" required /></label></div>
            <div><label>Data di nascita: <input name="DataDiNascita" id="edit-data" required /></label></div>
            <div><label>Nazionalità: <input name="Nazionalita" id="edit-nazionalita" /></label></div>
            <div><label>Colore: <input name="Colore" id="edit-colore" /></label></div>
            <div>
                <button type="submit">Salva Modifiche</button>
            </div>
        </form>
    </details>

    <a class="torna" asp-action="Index" asp-controller="Home">← Torna alla home</a>

</div>

<script>
    function caricaPilotaInForm(id, nome, cognome, data, nazionalita, colore) {
        document.getElementById('edit-id').value = id;
        document.getElementById('edit-nome').value = nome;
        document.getElementById('edit-cognome').value = cognome;
        document.getElementById('edit-data').value = data;
        document.getElementById('edit-nazionalita').value = nazionalita;
        document.getElementById('edit-colore').value = colore;

        // Apre automaticamente il pannello di modifica
        document.getElementById('details-modifica').open = true;
        
        // Fai uno scroll fluido fino al form di modifica per far capire all'utente che si è aperto
        document.getElementById('details-modifica').scrollIntoView({ behavior: 'smooth' });
    }
</script>