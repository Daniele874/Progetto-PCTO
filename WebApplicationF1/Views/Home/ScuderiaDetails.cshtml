@model WebApplicationF1.Models.Scuderia
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Scuderia</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        .team-header { color:white; margin:10px 0; }
    </style>
</head>
<body>
    <div class="season"><p>@Model.Nome</p></div>
    <div class="box">
        @if (Model == null)
        {
            <p style="color:white;">Scuderia non trovata.</p>
        }
        else
        {
            var teamRaw = (Model.Nome ?? "").Trim();
            var teamCls = (Model.Nome ?? "").Replace(" ", "");


                @if (Model.IdPilota1 != null)
                {
                    var p1Raw = (Model.Pilota1Colore ?? teamCls ?? "").Trim();
                    var p1Cls = new string(p1Raw.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
                    <div class="boxDriver @(p1Cls)" id="pilot-@Model.IdPilota1">
                        <div class="boxContent">
                            <h3>@(($"{Model.Pilota1Nome} {Model.Pilota1Cognome}").Trim())</h3>
                        </div>
                        <img src="~/css/Assets/@(Model.Pilota1Cognome).png" alt="@(Model.Pilota1Nome)" />
                    </div>
                }

                @if (Model.IdPilota2 != null)
                {
                    var p2Raw = (Model.Pilota2Colore ?? teamCls ?? "").Trim();
                    var p2Cls = new string(p2Raw.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
                    <div class="boxDriver @(p2Cls)" id="pilot-@Model.IdPilota2">
                        <div class="boxContent">
                            <h3>@(($"{Model.Pilota2Nome} {Model.Pilota2Cognome}").Trim())</h3>
                        </div>
                        <img src="~/css/Assets/@(Model.Pilota2Cognome).png" alt="@(Model.Pilota2Nome)" />
                    </div>
                }

            
        }
    </div>
</body>
</html>