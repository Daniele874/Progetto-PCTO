@model WebApplicationF1.Models.ScuderiaDettagliViewModel

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Scuderia</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
            .team-header {
                color: white;
                margin: 10px 0;
            }
    </style>
</head>
<body>
    <div class="season">
        <p>@Model.NomeScuderia</p>
    </div>
    
    <div class="box">
        @if (Model == null)
        {
            <p style="color:white;">Scuderia non trovata.</p>
        }
        else
        {
            var teamCls = (Model.NomeScuderia ?? "").Replace(" ", "");

            @if (Model.Pilota1 != null)
            {
                var p1Raw = (Model.Pilota1.Colore ?? teamCls ?? "").Trim();
                var p1Cls = new string(p1Raw.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
                <a asp-action="StoricoPilota" asp-route-id="@Model.IdPilota1" class="boxDriver @(p1Cls)" id="pilot-@Model.Pilota1.IdPilota">
                
                    <div class="boxContent">
                            <h3>@(($"{Model.Pilota1.Nome} {Model.Pilota1.Cognome}").Trim())</h3>
                    </div>
                    <img src="~/css/Assets/@(Model.Pilota1.Cognome).png" alt="@(Model.Pilota1.Nome)" />
                </a>
            }

            @if (Model.Pilota2 != null)
            {
                var p2Raw = (Model.Pilota2.Colore ?? teamCls ?? "").Trim();
                var p2Cls = new string(p2Raw.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
                <a asp-action="StoricoPilota" asp-route-id="@Model.IdPilota2" class="boxDriver @(p2Cls)" id="pilot-@Model.Pilota2.IdPilota">
                
                    <div class="boxContent">
                        <h3>@(($"{Model.Pilota2.Nome} {Model.Pilota2.Cognome}").Trim())</h3>
                    </div>
                    <img src="~/css/Assets/@(Model.Pilota2.Cognome).png" alt="@(Model.Pilota2.Nome)" />
                </a>

            }
        }
        
            <table class="boxClassifica">
                <tr>
                    <td>Gran Premi Disputati:</td>
                    <td>@Model.GpFatti</td>
                </tr>
                <tr>
                    <td>Punti Totali:</td>
                    <td>@Model.Punti</td>
                </tr>
                <tr>
                    <td>Podi:</td>
                    <td>@Model.Podi</td>
                </tr>
                <tr>
                    <td>Vittorie:</td>
                    <td>@Model.Vittorie</td>
                </tr>
                <tr>
                    <td>Pole Position:</td>
                    <td>@Model.PolePosition</td>
                </tr>
                <tr>
                    <td>Titoli Mondiali:</td>
                    <td><strong>@Model.CampioniDelMondo</strong></td>
                </tr>
            </table>
        <br />
        <a class="torna" asp-action="Scuderie" asp-controller="Home">← Torna alle scuderie</a>
    </div>
</body>
</html>