@model IEnumerable<WebApplicationF1.Models.Campionato>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Campionati</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <div class="box">
        @if (Model == null || !Model.Any())
        {
            <p style="color:white; font-family:sans-serif; padding:20px;">Nessun campionato trovato.</p>
        }
        else
        {
            foreach (var c in Model)
            {
                var raw = (c.Colore ?? "").Trim();
                var normalized = new string(raw.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
                <div class="boxDriver @(normalized)">
                    <a href="@Url.Action("Risultato", "Home", new { id = c.IdCampionato })" style="color:inherit; text-decoration:none; display:block;">
                        <div class="boxContent">
                            <p>@c.Anno</p><br />
                            <h2>Campionato @c.Anno</h2>
                            <p>Gare: @c.NumeroGare</p>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
</body>
</html>