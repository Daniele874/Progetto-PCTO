@model IEnumerable<WebApplicationF1.Models.Scuderia>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Scuderie</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <div class="season">2026 LINE-UP</div>

    <div class="box">
        @foreach (var s in Model)
        {
            var raw = (s.Nome ?? "").Trim();
            var cls = (s.Nome ?? "").Replace(" ", "");
            <div class="boxCar @(cls)" onclick="location.href='@Url.Action("ScuderiaDetails","Home", new { id = s.IdScuderia })'" style="cursor:pointer;">
                <div class="boxContent">
                    <p>@s.Nome</p><br />
                    @* Piloti non mostrati qui, vengono visualizzati nella pagina della scuderia *@
                </div>
                <img src="@Url.Content("~/css/Assets/" + (s.Nome?.Replace(" ", "") ?? "default") + ".png")" alt="@s.Nome" />
            </div>
        }
    </div>
</body>
</html>