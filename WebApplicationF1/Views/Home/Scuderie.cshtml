@model IEnumerable<WebApplicationF1.Models.Scuderia>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Scuderie</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="box">
        @foreach (var s in Model)
        {
            <div class="boxCar @(s.Nome)" id="@s.Nome?.Replace(" ", "")">
                <div class="boxContent">
                    <p>@s.Nome</p><br />
                    @if (!string.IsNullOrEmpty(s.PilotaNome) || !string.IsNullOrEmpty(s.PilotaCognome))
                    {
                        <h3>Pilota: @(($"{s.PilotaNome} {s.PilotaCognome}").Trim())</h3>
                    }
                </div>
                <img src="@Url.Content("~/css/Assets/" + (s.Nome?.Replace(" ", "") ?? "default") + ".png")" alt="@s.Nome" />
            </div>
        }
    </div>
</body>
</html>